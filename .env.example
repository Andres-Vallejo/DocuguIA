# Configura la clave desde la interfaz local; nunca la subas a GitHub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Marca true solo tras comprobar que TU proyecto de Google aparece en Free.
GEMINI_FREE_TIER_CONFIRMED=false
# Controles locales, independientes de las cuotas que aplique Google.
MAX_GEMINI_CALLS_PER_DAY=15
MIN_GEMINI_INTERVAL_SECONDS=12
